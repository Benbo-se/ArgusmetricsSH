# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ============================================
# CLAUDE CODE / AI
# ============================================
.claude/*
!.claude/goldenrules.md

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak
*.tmp
*.temp

# ============================================
# DATABASE
# ============================================
*.sqlite
*.sqlite3
*.db
GeoLite2-Country.mmdb

# ============================================
# LOGS
# ============================================
logs/
*.log
log/

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# ============================================
# SECRETS & KEYS (NEVER COMMIT!)
# ============================================
*.pem
*.key
*.crt
*.p12
secrets/
credentials/
credentials.json

# ============================================
# BACKUP FILES
# ============================================
backup/
*.backup
*.bkp

# ============================================
# BUILD OUTPUTS (keep tracking-script/dist)
# ============================================
# frontend/tracking-script/dist/ is intentionally tracked (the shipped build);
# the global dist/ rule above must not swallow it.
!frontend/tracking-script/dist/

# ============================================
# PLAYWRIGHT / E2E
# ============================================
e2e/playwright-report/
e2e/test-results/
# e2e/package-lock.json is committed on purpose: npm ci needs it, and
# pinning Playwright is the point of having a lockfile at all.

# ============================================
# MISC
# ============================================
.ipynb_checkpoints/
*.pid
*.seed
*.pid.lock
