# ── Argusmetrics self-host configuration ──────────────────────────────────
# Copy to `.env` in this directory and edit. Only SECRET_KEY truly matters to
# get started; everything else has sane defaults and external services are
# optional.

# PostgreSQL (used by the bundled postgres container)
POSTGRES_DB=argusmetrics
POSTGRES_USER=argusmetrics
POSTGRES_PASSWORD=change-me

# REQUIRED. Generate one, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Environment
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:8020

# Production only (docker-compose.prod.yml): host port the web container binds
# on 127.0.0.1, and which image tag to run (CI sets this to a git SHA).
# WEB_PORT=8021
# ARGUS_TAG=latest
# Public URL of the deployment. Also feeds the TrustedHost allowlist: only this
# host (port ignored; a www. URL also covers the apex) is accepted in prod mode.
# BASE_URL=https://www.argusmetrics.io

# Database URL (backend -> postgres over the internal docker network)
DATABASE_URL=postgresql://argusmetrics:change-me@postgres:5432/argusmetrics

# ── Optional hardening ────────────────────────────────────────────────────
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted. Leave empty
# unless you run behind a reverse proxy/CDN (otherwise XFF is ignored — safe).
# TRUSTED_PROXIES=

# Path to a MaxMind GeoLite2-Country.mmdb for country stats. If unset, country
# is "Unknown" and NO third-party IP lookups are ever made (no data leaves you).
# GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# ── Optional external services (features degrade gracefully if unset) ──────
# Email (magic-link login + reports). Without it, login links are only shown
# in DEBUG mode. See backend/app/services/email_service.py.
# LETTERMINT_API_KEY=
