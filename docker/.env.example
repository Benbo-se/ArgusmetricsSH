# ── Argusmetrics self-host configuration ──────────────────────────────────
# Copy to `.env` in this directory and edit. Only SECRET_KEY truly matters to
# get started; everything else has sane defaults and external services are
# optional.

# PostgreSQL (used by the bundled postgres container)
POSTGRES_DB=argusmetrics
POSTGRES_USER=argusmetrics
POSTGRES_PASSWORD=change-me
# Production only: password for the least-privilege role the app connects as
# (DML only, owns nothing; migrations run as the owner above). Created on the
# FIRST start of a fresh database volume.
# APP_DB_PASSWORD=change-me-too

# REQUIRED. Generate one, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Environment
ENVIRONMENT=development
DEBUG=true

# Production only (docker-compose.prod.yml): host port the web container binds
# on 127.0.0.1, and which image tag to run (CI sets this to a git SHA).
# WEB_PORT=8021
# ARGUS_TAG=latest
# Public URL of the deployment. Also feeds the TrustedHost allowlist: only this
# host (port ignored; a www. URL also covers the apex) is accepted in prod mode.
# BASE_URL=https://www.argusmetrics.io

# Database URL (backend -> postgres over the internal docker network)
DATABASE_URL=postgresql://argusmetrics:change-me@postgres:5432/argusmetrics

# ── Optional hardening ────────────────────────────────────────────────────
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted. Leave empty
# unless you run behind a reverse proxy/CDN (otherwise XFF is ignored — safe).
# TRUSTED_PROXIES=

# Path to a MaxMind GeoLite2-Country.mmdb for country stats. If unset, country
# is "Unknown" and NO third-party IP lookups are ever made (no data leaves you).
# GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# Data retention: delete analytics events older than N days (nightly job).
# 0 = keep forever. Email logs age out after 90 days regardless.
#
# 730 is what this instance runs: twenty-four months. The number is set by a
# feature rather than a preference. The dashboard offers a 365 day range and
# compares every range against the period immediately before it, so a
# 365 day view needs the 365 days before that to compare against. At 365 days
# of retention that comparison is empty and the view quietly loses half its
# meaning.
#
# Year-on-year on a calendar month needs more than 365 days too: on the 20th
# of a month you would need the 1st of the same month last year, which is
# already 385 days back.
#
# It is stated in the privacy policy, so changing it here means changing that
# too. The tests in test_promises_match_config.py will say so.
#
# The purge deletes in batches, each its own transaction, so it cannot lock
# the tracking tables while visitors are being recorded. On the FIRST run
# after enabling this on a database that has never been purged, set a ceiling
# so it works through the backlog over several nights instead of in one go:
#
#   RETENTION_MAX_ROWS_PER_RUN=200000
#
# Remove it once the backlog is gone, or the tables never fully catch up.
DATA_RETENTION_DAYS=730
# RETENTION_MAX_ROWS_PER_RUN=0
# RETENTION_BATCH_SIZE=10000

# Email delivery logs hold recipient addresses, so they are kept for a much
# shorter time than analytics events and on their own schedule.
# EMAIL_LOG_RETENTION_DAYS=90

# ── Limits ─────────────────────────────────────────────────────────────────
# Both are OFF or generous by default. A private instance tracking your own
# sites wants neither of them, and nothing here is needed to run one.
#
# MONTHLY_EVENT_LIMIT caps how many events one account may record per calendar
# month, counted across every website that account owns: pageviews, custom
# events and ecommerce events together. 0 means no limit. Set it only if you
# let other people sign up on your instance.
#
# The count is kept by the database as events arrive, so checking it costs one
# indexed lookup and does not get slower as the database grows. An account
# over its limit gets 429 from the tracking endpoints and stops being
# recorded; the dashboard warns the owner at 80 percent, before data is lost.
#
# If the counter cannot be read, events are recorded anyway. Losing a
# customer's traffic because a limit check failed is not recoverable; letting
# a few extra events through is.
MONTHLY_EVENT_LIMIT=0

# The most websites one account may add. This is protection against someone
# filling the table, not a commercial limit, so it is set high: an agency
# running a hundred client sites should never meet it. 0 means no limit.
MAX_WEBSITES_PER_ACCOUNT=100

# ── Who may use this instance ──────────────────────────────────────────────
# The most important setting in this file if the instance is reachable from
# the internet. true means anyone who finds the URL can create an account.
# Off by default in the production compose: a private instance is the normal
# case, and open signup should be a decision somebody made on purpose.
ENABLE_REGISTRATION=false

# Require a working email address before an account can be used. Leave it on
# unless you have no email configured at all: with verification required and
# no way to send it, signup creates accounts that can never log in.
#
# Turning it off makes new accounts usable immediately, which is fine on a
# closed instance and unacceptable on an open one, because anyone could then
# claim an address they do not own. The application refuses to start in
# production with registration open and verification off.
ENABLE_EMAIL_VERIFICATION=true

# ── Sessions and one-time links ────────────────────────────────────────────
# How long a login lasts, and how long a verification, reset or invitation
# link stays valid. The link window is deliberately short: those links are
# credentials, and they travel through email.
# SESSION_EXPIRY_DAYS=30
# MAGIC_TOKEN_EXPIRY_SECONDS=900

# ── Rate limits ────────────────────────────────────────────────────────────
# The general limits apply per IP across the API. The auth limits are separate
# and much tighter, because signup, login, verification and password reset are
# what a brute-force or an email-bombing run targets.
#
# Counting is per process. With more than one worker each keeps its own count,
# so the effective limit is multiplied by the number of workers.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000
# RATE_LIMIT_PER_DAY=10000
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ── Logging and operations ─────────────────────────────────────────────────
# LOG_FORMAT is json in production, where the log is read by a machine first
# and a traceback stays one searchable line instead of thirty. Every line
# carries a request id, which is also returned in the X-Request-Id response
# header, so a customer can quote the number from the page they were on.
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Error reporting. Leave empty to send nothing anywhere, which is the default.
# SENTRY_DSN=

# Database connections held open by the app. The defaults suit a single
# instance; raise them only if you actually see connections queueing.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── Branding ───────────────────────────────────────────────────────────────
# APP_NAME appears in the interface and in emails. BRAND_NAME is also used in
# the DNS TXT record that verifies domain ownership, so changing it after
# somebody has verified a domain invalidates their record.
# APP_NAME=Argusmetrics
# BRAND_NAME=argusmetrics

# ── Email ──────────────────────────────────────────────────────────────────
# Which backend delivers verification, reset, invitation and report mail:
# 'smtp' for any provider, 'lettermint' for the EU-based API service.
# EMAIL_BACKEND=smtp
#
# ── SMTP (any provider) ────────────────────────────────────────────────────
# Needed for: signup verification emails, password resets, team invitations,
# and scheduled reports. Everyday login uses a password and works without it.
# Without SMTP, verification links/codes are printed to the backend logs
# (`docker compose logs backend`) so the owner is never locked out.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_FROM_NAME=Argusmetrics
# SMTP_USE_TLS=true

# Legacy alternative: Lettermint HTTP API (SMTP above is preferred)
# LETTERMINT_API_KEY=
# LETTERMINT_FROM_EMAIL=noreply@your-domain.com
# LETTERMINT_FROM_NAME=Argusmetrics
